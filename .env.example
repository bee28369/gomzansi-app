# Copy to .env and fill in. Never commit .env.

# Supabase project (Settings -> API). The anon key is designed to be public;
# data access is protected by Row Level Security in supabase/migrations.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Mapbox PUBLIC token (pk.*) used at runtime for maps + Directions API.
EXPO_PUBLIC_MAPBOX_TOKEN=pk.YOUR_PUBLIC_MAPBOX_TOKEN

# Base URL of the hosted web tracker (see /web). Share links look like <base>/<token>.
EXPO_PUBLIC_TRACK_BASE_URL=https://gomzansi.app/track

# Mapbox SECRET token (sk.*, scope DOWNLOADS:READ). Needed ONLY at native
# build time (expo prebuild / run:android / run:ios). Never ship in the app.
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=sk.YOUR_SECRET_DOWNLOAD_TOKEN
